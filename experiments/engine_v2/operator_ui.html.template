<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ニュースの現在地・今日の確認作業</title>
<style>
:root{font:17px/1.6 system-ui,sans-serif;color:#183432;background:#f1f5f3}*{box-sizing:border-box}body{margin:0}header{position:sticky;top:0;z-index:2;background:#15473f;color:#fff;padding:7px 14px;display:flex;align-items:center;justify-content:space-between;gap:8px}h1{font-size:17px;margin:0}header small{color:#e1f5eb;font-size:12px}main{max-width:720px;margin:auto;padding:12px 12px 24px}h2{font-size:23px;line-height:1.4;margin:14px 0}h3{font-size:19px;line-height:1.5;margin:10px 0}p{margin:8px 0}button,input,textarea,select{font:inherit;min-height:48px;border:1px solid #668078;border-radius:10px;max-width:100%;padding:10px}button{cursor:pointer;background:#fff;color:#17483f;margin:4px 4px 4px 0}button.primary{background:#176b56;color:#fff}button.danger{border-color:#a53736;color:#a53736}button[aria-pressed=true]{background:#d7f1df;border:2px solid #176b56}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible{outline:3px solid #c68105;outline-offset:2px}input[type=checkbox]{width:24px;height:24px;min-height:24px;flex:none}select,textarea{width:100%}textarea{min-height:80px}article,.card{background:#fff;border:1px solid #d2ded8;border-radius:14px;padding:14px;margin:12px 0}.warning{background:#fff2d5;border-left:4px solid #c18516;padding:10px;border-radius:4px}.safe{background:#dfefe5;padding:10px}.muted,small{color:#52685e}a{color:#006a66;overflow-wrap:anywhere}details{margin:10px 0}summary{min-height:44px;padding:8px 0;cursor:pointer}pre,code{font:13px/1.6 monospace;overflow-wrap:anywhere;white-space:pre-wrap}pre{background:#f1f4f2;padding:9px}blockquote{border-left:3px solid #6b9a89;margin:8px 0;padding:6px 10px;background:#f3f7f4}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tile{text-align:left;min-height:118px;margin:0;padding:12px}.tile strong{display:block;font-size:30px}.row{display:flex;gap:7px;flex-wrap:wrap}.choices{display:grid;gap:5px}.choices button{text-align:left;width:100%;margin:0}.badge{display:inline-block;padding:3px 10px;border-radius:18px;background:#e3eee7;font-size:14px}label.check{display:flex;gap:8px;align-items:center;min-height:48px;border-bottom:1px solid #e1e8e3;padding:4px 0}label{display:block;margin:7px 0}.bar{position:static;flex-wrap:wrap;background:#ffffffed;border-top:1px solid #d2ded8;padding:6px 12px;display:flex;justify-content:center;gap:8px}.bar button{margin:0}.notice{white-space:pre-wrap}dialog{width:min(94vw,640px);max-height:88vh;border:1px solid #68867a;border-radius:14px;padding:16px;overflow:auto}dialog::backdrop{background:#0008}[hidden]{display:none!important}.preview{border:2px solid #478a6a;padding:12px;border-radius:10px}.step{font-size:14px;font-weight:bold;color:#406952}.risk{color:#953428;font-weight:bold}
@media(max-width:380px){:root{font-size:16px}.tile{padding:10px}.bar button{font-size:15px;padding:8px}}

body,h1,h2,h3,p,td,th,span,button{overflow-wrap:anywhere}select{min-width:0}fieldset{min-width:0;border:1px solid #ccd8cf;border-radius:10px;padding:10px}.compare-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:14px}.compare-table td,.compare-table th{border:1px solid #ccd8cf;padding:6px;vertical-align:top;text-align:left}.compare-table .badge{display:block;margin-top:4px;padding:2px 4px}.compare-table summary{font-size:13px}.compare-table blockquote{margin:4px 0;padding:4px}.compare-table th:first-child{width:27%}input,textarea,select,button{scroll-margin:72px 0 24px}.bar{padding-bottom:calc(12px + env(safe-area-inset-bottom))}button{touch-action:manipulation}
.support-box{background:#eef5f2;border:1px solid #8bab9d;border-radius:10px;padding:10px;margin:8px 0}.evidence-article{border:1px solid #cadad1;border-radius:8px;padding:8px}.support-summary{padding:6px 0}textarea{scroll-margin-top:80px}button,input,select,textarea{font-size:16px}
</style></head><body>
<header><h1>ニュースの現在地</h1><small id="mode">端末内の操作練習</small></header>
<main><p id="notice" class="notice" role="status" aria-live="polite"></p><div id="content"></div><details id="errorDetails" hidden><summary>詳しい停止理由</summary><pre id="errorText"></pre></details></main>
<div class="bar"><button id="home">今日の作業へ</button><button id="reload">再読込</button><button id="history">確認済み・履歴</button></div>
<dialog id="confirmDialog"><h2 id="confirmTitle">公開内容の最終確認</h2><div id="confirmBody"></div><label>確認した理由<textarea id="confirmReason" placeholder="根拠と表示内容を確認しました"></textarea></label><div class="row"><button id="confirmYes" class="primary">確認して実行</button><button id="confirmNo">戻る</button></div></dialog>
<dialog id="previewDialog"><h2>仮承認後の公開プレビュー</h2><p class="warning">確認用です。承認はまだ保存されていません。</p><div id="previewBody"></div><button id="closePreview">閉じる</button></dialog>
<script id="offlineSnapshot" type="application/json">null</script>
<script>
'use strict';
const OFFLINE_DATA=JSON.parse(document.getElementById('offlineSnapshot').textContent);
const TOKEN='__LOCAL_TOKEN__';
const $=id=>document.getElementById(id);
const LABEL={unknown:'未確認',unapproved:'未承認',approved:'承認済み',needs_recheck:'再確認が必要',withdrawn:'公開取消し済み',superseded:'新しい確認へ更新済み',current:'現在の判断',cancelled:'取り消された判断',accepted:'安全検証を通過（正解確認ではありません）',active:'追跡中',review:'確認中',completed:'完結',dormant:'休眠中',available:'保存本文あり・出典確認は未検証',deleted:'削除が記録されています',empty_body:'本文が空です',request_failed:'取得に失敗しています',current_stage:'現在の進展段階',lifecycle:'追跡状態',summary:'事件の概要',updated_at:'最終更新日時',latest:'最新の動き',next_watch:'今後の確認点',exact_literal_match:'保存内容との文字列一致',stale_source:'記事が変わったため再確認が必要',not_provided:'引用なし',literal_mismatch:'保存内容と引用が一致しません',body:'本文',title:'見出し',description:'記事の紹介文',published:'公開日時',metadata:'記事の版',availability:'取得状態',same_event:'同じ事件',different_event:'別の事件',hold:'判断できない・保留',new:'新しい進展あり',none:'新しい進展なし',possible_correction:'訂正・撤回の可能性',not_requested:'訂正の判断なし',operator_reported_new:'新しい進展の確認記録・安全検証待ち',already_recorded_literal_candidate:'既存の引用と同じ内容を含むため重複報道の候補',needs_evidence:'進展の根拠が不足・要確認',operator_reported_no_change:'新しい進展なしの確認記録',not_reviewed:'進展は未確認'};
const CATEGORIES={identity:'事件の判定待ち',progress:'続報・進展の確認待ち',publication:'公開の確認待ち',hold:'保留・再確認が必要'};
let state=null,busy=false,view={page:'home'},choice=null,selectedTargets=new Set(),pending=null,lastResult=null;
function el(tag,text,parent){const n=document.createElement(tag);if(text!==undefined)n.textContent=typeof text==='string'?text:JSON.stringify(text,null,2);if(parent)parent.append(n);return n;}
function note(text){$('notice').textContent=text;}
function jp(value){return LABEL[value]||'詳細情報で確認';}
function date(value){if(!value)return '未確認';const d=new Date(value);if(Number.isNaN(d.getTime()))return '未確認';const p=Object.fromEntries(new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',year:'numeric',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d).map(x=>[x.type,x.value]));return `${p.year}年${p.month}月${p.day}日 ${p.hour}:${p.minute}`;}
function button(text,fn,parent,cls=''){const b=el('button',text,parent);b.type='button';b.className=cls;b.onclick=fn;return b;}
function detail(label,value,parent){const d=el('details',undefined,parent);el('summary',label,d);el('pre',value,d);return d;}
function link(url,parent){try{const u=new URL(url);if(!['http:','https:'].includes(u.protocol))return;const a=el('a','記事を開く（外部サイト）',parent);a.href=u.href;a.target='_blank';a.rel='noopener noreferrer';a.onclick=e=>{if(!confirm('外部の記事を開きます。本文の自動取得はしません。開きますか？'))e.preventDefault();};}catch{el('p','記事URLは未確認です。',parent);}}
function go(next){keepReview();view=next;choice=null;selectedTargets=new Set();render();window.scrollTo(0,0);}
function draft(id){try{return localStorage.getItem('news-now-reason:'+id)||'';}catch{return '';}}
function saveDraft(id,v){try{localStorage.setItem('news-now-reason:'+id,v);}catch{note('この端末では下書きの保存が使えません。');}}
function fail(error){note('安全のため停止しました。'+(/[^\x00-\x7F]/.test(error.message)?error.message:'根拠や判断の条件を確認してください。'));$('errorDetails').hidden=false;$('errorText').textContent=error.message;}
async function refresh(){if(busy)return;if(OFFLINE_DATA){state=OFFLINE_DATA;note((state.data_scope==='synthetic_demo'?'架空データの':'保存済みデータ（未再検証）の')+'閲覧専用画面です。選択して表示を試せますが、判断・承認は保存できません。');render();return;}try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw Error('読込できませんでした。');state=await r.json();render();}catch(e){fail(e);}}
async function request(path,command){const r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json','X-Local-Token':TOKEN},body:JSON.stringify(command)});const data=await r.json();if(!r.ok){const e=Error(data.error||'処理を停止しました。');e.definitive=r.status>=400&&r.status<500;throw e;}return data;}
async function post(command,next){if(OFFLINE_DATA)return note('閲覧専用です。判断・承認・取消しは保存できません。');if(busy)return;if(sessionStorage.getItem('news-now-work-pending'))return note('保存結果が未確認です。「未完了の操作を同じ番号で確認」を使ってください。');busy=true;const disabled=Array.from(document.querySelectorAll('button'),b=>[b,b.disabled]);disabled.forEach(([b])=>b.disabled=true);try{const payload={...command,revision:state.revision,op:crypto.randomUUID()};sessionStorage.setItem('news-now-work-pending',JSON.stringify(payload));const data=await request('/api/operate',payload);sessionStorage.removeItem('news-now-work-pending');if(choice?.contextKey){reviewInputs.delete(choice.contextKey);sessionStorage.removeItem(choice.contextKey);}state=data.state;lastResult=data.result;$('errorDetails').hidden=true;note(command.action==='task_review'?'確認記録を保存しました。統合・進展確定・公開はまだ行っていません。':'項目ごとの安全検証を通して保存しました。');if(next?.nextTask){const t=state.work.tasks.find(t=>t.category===next.category&&t.task_id!==command.task_id);view=t?(t.article?{page:'review',taskId:t.task_id,category:t.category,returnOffset:view.offset||0}:{page:'publication',eventId:t.event_id,category:t.category,returnOffset:view.offset||0}):{page:'list',category:next.category};}else if(next)view=next;choice=null;selectedTargets.clear();}catch(e){if(e.definitive)sessionStorage.removeItem('news-now-work-pending');keepReview();fail(e);}finally{busy=false;disabled.forEach(([b,v])=>b.disabled=v);render();}}
function item(eid){return state.items.find(i=>i.event.event_id===eid);}
function task(id){return state.work.tasks.find(t=>t.task_id===id);}
function title(t){return t.article?.title||item(t.event_id)?.event.event_name||'確認作業';}
function targetName(t){return t.kind==='event'?'事件名・分類':t.kind==='field'?jp(t.key):({article:'根拠記事',progress:'進展の記録',schedule:'今後の予定',correction:'訂正・注意事項',revision:'記事の更新履歴'})[t.kind]||'公開項目';}
function targetId(t){return JSON.stringify([t.kind,t.key]);}
function reader(event,parent,unapproved=false){const p=el('section',undefined,parent);p.className='preview';if(unapproved)el('p','公開前の確認用・未承認です。この表示のまま公開できません。',p).className='warning';el('h3',event.event_name,p);el('p','概要：'+(event.summary||'確認中'),p);el('p','現在地：'+(event.current_stage||'確認中'),p);el('h3','進展の時系列',p);timeline(event,p);el('h3','根拠記事',p);for(const a of event.articles||[]){el('p',a.title,p);el('small','報道の公開日時：'+date(a.published)+'（日本時間）',p);link(a.url,p);}el('h3','訂正・注意事項',p);if(!(event.corrections||[]).length)el('p','この表示に含まれる訂正記録はありません。未確認情報がないことの証明ではありません。',p);for(const c of event.corrections||[])el('p',c.reason||c.summary||c.note||'訂正の詳細を確認してください。',p);}
function timeline(event,parent){const rows=event.progress_history||[];if(!rows.length)el('p','記録された重要な進展はありません。',parent);for(const row of rows.slice(-4)){el('p','・'+(row.stage||row.current_stage||'進展の記録'),parent);el('small','報道の公開日時：'+date(row.source_at||row.at)+' ／ 出来事の発生日時：'+date(row.event_occurred_at),parent);}if(rows.length>4)detail('すべての経過（詳細情報）',rows,parent);}
function dashboard(parent){el('h2','今日の確認作業',parent);el('p',state.data_scope==='synthetic_demo'?'架空の操作例です。件数は実運用の値ではありません。':'読み込んだ保存データの集計です。本番の最新状況ではありません。',parent).className='muted';el('p','優先：訂正・再確認 → 事件の確認 → 進展の確認 → 公開の確認',parent);const grid=el('div',undefined,parent);grid.className='grid';for(const [key,name] of Object.entries(CATEGORIES)){const b=button('',()=>go({page:'list',category:key}),grid,'tile');el('span',name,b);el('strong',state.work.counts[key]+'件',b);}el('p','同じ記事の重複や過去の記録は件数に含めません。共有記事は事件ごと、公開確認は事件ごとの作業です。',parent).className='muted';const next=state.work.tasks[0];if(next){const a=el('article',undefined,parent);el('span','先に確認したい作業',a).className='badge';el('h3',title(next),a);el('p',next.reason,a);button('この1件を確認する',()=>openTask(next),a,'primary');}else el('p','現在、人による未処理の確認作業はありません。',parent).className='safe';detail('自動処理待ち・過去記録について',{自動処理待ち:state.work.ai_waiting,一覧から除外した過去記録:state.work.excluded_history,集計単位:state.work.unit},parent);if(OFFLINE_DATA)el('p','閲覧専用です。判断や承認を選んでも保存されません。',parent).className='warning';}
function openTask(t){go(t.article?{page:'review',taskId:t.task_id,category:t.category,returnOffset:view.offset||0}:{page:'publication',eventId:t.event_id,category:t.category,returnOffset:view.offset||0});}
function list(parent){el('h2',CATEGORIES[view.category],parent);const rows=state.work.tasks.filter(t=>t.category===view.category);if(!rows.length)el('p','この種類の未処理作業はありません。',parent);const offset=view.offset||0;for(const t of rows.slice(offset,offset+20)){const a=el('article',undefined,parent);el('h3',title(t),a);if(t.required_event_id)el('p','確認対象：'+item(t.required_event_id).event.event_name,a);el('p',t.reason,a);el('small',t.priority===0?'優先して再確認':'人による確認が必要',a);button('確認する',()=>openTask(t),a,'primary');}if(offset>0)button('前の20件',()=>go({...view,offset:Math.max(0,offset-20)}),parent);if(offset+20<rows.length)button('次の20件',()=>go({...view,offset:offset+20}),parent);if(rows.length)el('p',(offset+1)+'〜'+Math.min(offset+20,rows.length)+'件目 ／ 全'+rows.length+'件',parent);}
const reviewInputs=new Map();
function reviewKey(t,eid){return JSON.stringify(['operator-input-v2',t.task_id,eid,t.review_contexts[eid||'none'],t.drafts_by_event?.[eid]?.draft_id]);}
function keepReview(){if(!choice?.contextKey)return;reviewInputs.set(choice.contextKey,JSON.parse(JSON.stringify(choice)));if(!OFFLINE_DATA)try{sessionStorage.setItem(choice.contextKey,JSON.stringify(choice));}catch{note('入力の一時保持が使えません。この画面内では保持します。');}}
function loadChoice(t,eid){const key=reviewKey(t,eid);let stored=reviewInputs.get(key);if(!stored&&!OFFLINE_DATA)try{stored=JSON.parse(sessionStorage.getItem(key)||'null');}catch{}
 const base={contextKey:key,taskId:t.task_id,eid,relation:null,progress:null,proposed_stage:null,reason:'',reason_codes:[],new_fact:'',difference:'',evidence_ids:[],duplicate_checked:false,occurred:'',branches:{},lastSameProgress:null,applied_fields:[]};
 return stored?.contextKey===key?{...base,...stored}:base;
}
function switchDecision(relation,progress){
 const old=(choice.relation||'unselected')+':'+(choice.progress||'first');choice.branches[old]={reason:choice.reason,reason_codes:[...choice.reason_codes]};
 if(choice.relation==='same_event')choice.lastSameProgress=choice.progress;
 choice.relation=relation;choice.progress=relation==='same_event'?(progress===undefined?choice.lastSameProgress:progress):null;
 const b=choice.branches[relation+':'+(choice.progress||'first')];choice.reason=b?b.reason:choice.reason;choice.reason_codes=b?.reason_codes?[...b.reason_codes]:[];keepReview();
}
function supportingArticles(t,eid,parent,selectable=false){
 const cards=t.drafts_by_event?.[eid]?.evidence_cards||[];const grouped=new Map();
 for(const p of cards){const k=JSON.stringify([p.article.url,p.version_id]);if(!grouped.has(k))grouped.set(k,[]);grouped.get(k).push(p);}
 if(!cards.length)el('p','この事件に対応づけた引用は未確認です。',parent);
 for(const proofs of grouped.values()){
  const p=proofs[0],a=p.article,d=el('details',undefined,parent);d.className='evidence-article';d.open=selectable;el('summary','根拠記事：'+(a.title||'見出し未確認'),d);
  el('p',(a.source||a.publisher||'媒体名未確認')+' ／ 記事公開日時：'+date(a.published)+'（日本時間）',d);el('p','出来事の発生日時：'+(p.event_occurrence_text? p.event_occurrence_text+'（引用中の記述・未検証）':date(p.event_occurred_at)),d);link(a.url,d);
  el('p','本文取得：'+(p.body_available?'保存本文あり':'本文未確認')+' ／ 取得状態：'+jp(p.availability),d);el('p','出典の確認：'+p.source_verification+'。保存文字列の一致とは別の状態です。',d);
  for(const proof of proofs){const exact=proof.verification.status==='exact_literal_match';
   if(selectable){const l=el('label',undefined,d);l.className='check';const cb=el('input',undefined,l);cb.type='checkbox';cb.disabled=!exact;cb.checked=choice.evidence_ids.includes(proof.evidence_id);cb.onchange=()=>{choice.evidence_ids=cb.checked?[...choice.evidence_ids,proof.evidence_id]:choice.evidence_ids.filter(x=>x!==proof.evidence_id);keepReview();};el('span',proof.quote,l);}else el('blockquote',proof.quote,d);
   el('small',proof.field==='title'&&exact?'見出し一致・原文未確認':proof.field==='body'&&exact?'保存本文との文字列一致・出典確認は未検証':jp(proof.verification.status),d);
   detail('引用・記事版の技術情報',{根拠ID:proof.evidence_id,記事版:proof.version_id,状態:proof.verification},d);
  }
 }
}
function supportSummary(t,parent){const draft=t.drafts_by_event?.[choice.eid];if(!draft)return;
 const d=el('details',undefined,parent);d.className='support-summary';el('summary','判断材料の下書き（提案・未確認）',d);
 el('p',draft.reused_ai.length?'保存済みAI回答と引用を再利用しました。今回のAPI通信はありません。':'保存引用・記録からルールで整理しました。AI生成ではなく、API通信もありません。',d);
 for(const [key,label] of [['same_event_reasons','同じ事件と考える材料'],['different_event_reasons','別事件の可能性・相違点']]){el('h3',label+'（未確認）',d);for(const text of draft[key])el('p',text,d);}
 if(draft.reused_ai.length){const a=el('details',undefined,d);el('summary','保存済みAIの提案と記録ID',a);for(const r of draft.reused_ai){el('p','AIの理由（未確認）：'+(r.reason||'未確認'),a);el('p','段階の候補：'+(r.stage||'未確認'),a);}detail('再利用した判断ID',draft.reused_ai.map(r=>r.decision_id),a);}
 el('p','判断・公開承認は選択しません。対象事件と引用を人が確認してください。',d);
}
function progressSupport(t,parent,redraw){const draft=t.drafts_by_event?.[choice.eid];if(!draft)return;
 const box=el('section',undefined,parent);box.className='support-box';el('h3','進展の下書き（提案・未確認）',box);
 el('p','新しい事実の候補：'+(draft.new_fact||'未確認'),box);el('p','以前との差の候補：'+(draft.difference||'未確認'),box);el('p','進展段階の候補：'+(draft.proposed_stage||'未確認'),box);
 el('p','重複候補：'+(draft.duplicate_candidates.length?draft.duplicate_candidates.map(d=>d.stage+'（'+(d.kind==='literal_overlap'?'引用の重なり':'同じ段階のみ')+'・未確認）').join('／'):'保存記録からは未確認。重複がないことの保証ではありません。'),box);
 const b=button('下書きを入力欄に取り込む（未確認）',()=>{
