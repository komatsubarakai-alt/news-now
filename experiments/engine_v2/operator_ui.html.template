    for(const [key,text] of [['new_fact','新しく判明した事実（引用の原文をそのまま入力）'],['difference','以前の記録との違い（確認記録・未検証）']]){const l=el('label',text,second);const a=el('textarea',undefined,l);a.value=choice[key];a.oninput=()=>{choice[key]=a.value;keepReview();};}
