function selected(item){return item.targets.filter(t=>selectedTargets.has(targetId(t))).map(t=>({kind:t.kind,key:t.key,content_hash:t.content_hash}));}
async function bundlePreview(i){if(OFFLINE_DATA)return note('閲覧専用では仮承認を実行できません。');if(busy)return;busy=true;try{const data=await request('/api/preview-bundle',{revision:state.revision,event_id:i.event.event_id,targets:selected(i),reason:'公開前の仮確認'});$('previewBody').replaceChildren();if(!data.result.events.length)el('p','選んだ項目だけでは公開できません。事件と引用元の記事がすべて承認対象に入っているか確認してください。',$('previewBody'));for(const e of data.result.events)reader(e,$('previewBody'));detail('項目ごとの検証結果',data.result.results,$('previewBody'));$('previewDialog').showModal();}catch(e){fail(e);}finally{busy=false;}}
function ask(command,title,entries){if(OFFLINE_DATA)return note('閲覧専用のため保存できません。');pending=command;$('confirmTitle').textContent=title;$('confirmBody').replaceChildren();for(const t of entries){el('h3',targetName(t),$('confirmBody'));showTarget(t,$('confirmBody'));detail('根拠・判断・承認対象の詳細情報',t,$('confirmBody'));}$('confirmReason').value='';$('confirmDialog').showModal();}
function showTarget(t,parent){if(t.kind==='field')el('p',t.key==='updated_at'?date(t.content):t.key==='lifecycle'?jp(t.content):String(t.content),parent);else if(t.kind==='event')el('p',t.content.event_name||'事件名未確認',parent);else if(t.kind==='article'){el('p',t.content.title,parent);el('small','公開日時：'+date(t.content.published),parent);}else if(t.kind==='progress')el('p',(t.content.stage||'進展')+' ／ 報道日時：'+date(t.content.source_at||t.content.at),parent);else if(t.kind==='schedule')el('p',t.content.title||t.content.description||'予定の内容を詳細情報で確認してください。',parent);else el('p',t.content.reason||t.content.summary||t.content.note||'内容を詳細情報で確認してください。',parent);}
function publication(parent){const i=item(view.eventId);if(!i)return;button('← 元の一覧へ',()=>go({page:'list',category:view.category||'publication',offset:view.returnOffset||0}),parent);el('h2','公開してよい内容か確認',parent);reader(i.event,parent,true);el('h3','今回、確認する内容を選択',parent);el('p','内部では項目ごとに、記事版・引用・判断を検証します。チェックだけでは承認されません。',parent);button('安全検証を通せる未承認項目を選択',()=>{selectedTargets=new Set(i.targets.filter(t=>t.ready&&t.status!=='approved').map(targetId));render();},parent);for(const t of i.targets){const a=el('article',undefined,parent);const l=el('label',undefined,a);l.className='check';const check=el('input',undefined,l);check.type='checkbox';check.checked=selectedTargets.has(targetId(t));check.disabled=!t.ready||t.status==='approved';check.onchange=()=>{if(check.checked)selectedTargets.add(targetId(t));else selectedTargets.delete(targetId(t));};el('span',targetName(t)+' ／ '+jp(t.status),l);showTarget(t,a);if(!t.ready)el('p','根拠・記事版・現在の判断が揃っていないため停止しています。',a).className='warning';detail('詳細情報（承認対象・根拠・停止理由）',t,a);if(t.approval_id&&t.status!=='withdrawn'){const b=button('この内容の公開を取り消す',()=>ask({action:'withdraw',event_id:i.event.event_id,kind:t.kind,key:t.key},'公開取消しの確認',[t]),a,'danger');b.disabled=Boolean(OFFLINE_DATA);}}
 const preview=button('選んだ内容の公開前プレビュー',()=>bundlePreview(i),parent);preview.disabled=Boolean(OFFLINE_DATA);const approve=button('選んだ内容をまとめて最終確認',()=>{const targets=selected(i);if(!targets.length)return note('確認する項目を選んでください。');ask({action:'approve_bundle',event_id:i.event.event_id,targets},'選んだ公開内容の最終確認',i.targets.filter(t=>selectedTargets.has(targetId(t))));},parent,'primary');approve.disabled=Boolean(OFFLINE_DATA);el('h3','現在、承認済みの公開内容',parent);const actual=state.approved_preview.filter(e=>e.event_id===i.event.event_id);if(!actual.length)el('p','現在は公開可能な出力がありません。',parent);for(const e of actual)reader(e,parent);if(lastResult?.results)detail('直前の項目別保存結果',lastResult,parent);}
function history(parent){el('h2','確認済み・履歴',parent);for(const t of state.work.completed){const a=el('article',undefined,parent);el('h3',t.article.title,a);el('p','確認記録済み・安全検証待ち。統合・進展・公開の確定ではありません。',a);el('p',jp(t.record.relation)+' ／ '+(t.record.progress?jp(t.record.progress):'進展は未確認'),a);el('p',jp(t.record.progress_assessment),a);el('small','確認日時：'+date(t.record.recorded_at)+'（日本時間）',a);detail('確認記録の詳細情報',t,a);const re=button('この判断を見直す',()=>{const reason=prompt('見直す理由を入力してください。');if(reason?.trim())post({action:'reopen_task',event_id:t.record.event_id,task_id:t.task_id,reason},{page:'list',category:'hold'});},a);re.disabled=Boolean(OFFLINE_DATA);}for(const h of state.history){const a=el('article',undefined,parent);el('p',jp(h.new_status)+' ／ '+date(h.at),a);el('p',h.reason,a);detail('操作の詳細情報',h,a);}detail('過去も含む確認記録の詳細情報',state.work.review_history,parent);detail('過去の運営者判断の原記録（未再検証）',state.legacy_operator_records,parent);button('確認記録をJSONで保存',exportRecords,parent);}
function exportRecords(){const value={scope:'isolated_review_only_not_authority',revision:state.revision,work:state.work,history:state.history};const u=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=u;a.download='news-now-local-review-records.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}
function render(){if(!state)return;$('content').replaceChildren();$('mode').textContent=OFFLINE_DATA?(state.data_scope==='synthetic_demo'?'閲覧専用・架空データ':'閲覧専用・未再検証'):(state.data_scope==='synthetic_demo'?'架空データ・操作練習':'隔離試作・本番反映なし');const p=$('content');let saved;try{saved=sessionStorage.getItem('news-now-work-pending');}catch{}if(saved&&!OFFLINE_DATA)button('未完了の操作を同じ番号で確認',async()=>{if(busy)return;busy=true;try{const data=await request('/api/operate',JSON.parse(saved));sessionStorage.removeItem('news-now-work-pending');state=data.state;$('errorDetails').hidden=true;note('保存状況を確認しました。');}catch(e){if(e.definitive)sessionStorage.removeItem('news-now-work-pending');keepReview();fail(e);}finally{busy=false;render();}},p);if(view.page==='home')dashboard(p);else if(view.page==='list')list(p);else if(view.page==='review')review(p);else if(view.page==='publication')publication(p);else history(p);}
$('home').onclick=()=>go({page:'home'});$('reload').onclick=refresh;$('history').onclick=()=>go({page:'history'});$('confirmNo').onclick=()=>{pending=null;$('confirmDialog').close();};$('confirmYes').onclick=()=>{if(!pending||busy)return;const reason=$('confirmReason').value.trim();if(!reason)return note('確認した理由を入力してください。');const command={...pending,confirmed:true,reason};pending=null;$('confirmDialog').close();post(command);};$('closePreview').onclick=()=>$('previewDialog').close();refresh();
</script></body></html>
