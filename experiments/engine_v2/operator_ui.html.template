 function submit(first){const progress=first?null:choice.progress;const command={action:'task_review',task_id:t.task_id,context_hash:t.context_hash,event_id:choice.eid,relation:choice.relation,progress,proposed_stage:progress==='new'?choice.proposed_stage:null,reason:[...choice.reason_codes,choice.reason.trim()].filter(Boolean).join('／'),reason_codes:choice.reason_codes,event_occurred_at:progress==='new'&&choice.occurred?new Date(choice.occurred+':00+09:00').toISOString():null};const proposal=t.drafts_by_event?.[choice.eid];if(proposal)command.draft_review={draft_id:proposal.draft_id,applied_fields:choice.applied_fields};keepReview();if(progress==='new')command.progress_details={new_fact:choice.new_fact,difference:choice.difference,evidence_ids:choice.evidence_ids,duplicate_checked:choice.duplicate_checked};post(command,{nextTask:true,category:view.category});}
