<!doctype html><html lang="ja"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ニュースの現在地・隔離管理試作</title>
<style>
:root{font-family:system-ui,sans-serif;color:#172838;background:#edf3f5;font-size:17px}*{box-sizing:border-box}body{margin:0}header{position:sticky;top:0;background:#123d42;color:white;padding:12px 16px;z-index:1}h1{font-size:20px;margin:0}main{max-width:760px;margin:auto;padding:12px}button,select,input,textarea{font:inherit;min-height:48px;max-width:100%;border-radius:8px;border:1px solid #587279;padding:10px}button{background:#fff;color:#123d42;cursor:pointer;margin:4px 4px 4px 0}button.primary{background:#176c62;color:white}button.danger{color:#a02225;border-color:#a02225}button:disabled{opacity:.5;cursor:default}textarea{width:100%;min-height:72px}article,section.card{background:white;border-radius:12px;padding:15px;margin:12px 0;border:1px solid #cbd9dc}h2{font-size:20px}h3{font-size:18px}p{line-height:1.6}.warning{padding:12px;background:#fff1d4;color:#654400;border-left:5px solid #c58400}small,.muted{color:#52646b}a{color:#006678;overflow-wrap:anywhere}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;background:#f3f6f7;padding:10px}details{margin:12px 0;overflow-wrap:anywhere}summary{min-height:44px;padding:8px;cursor:pointer}.badge{display:inline-block;border-radius:20px;padding:5px 10px;background:#dcebe7}nav{display:flex;gap:8px}nav button{flex:1}.message{padding:10px;white-space:pre-wrap}label{display:block;margin:8px 0}.row{display:flex;gap:6px;flex-wrap:wrap}dialog{max-width:min(94vw,600px);max-height:90vh;border:1px solid #587279;border-radius:12px}dialog::backdrop{background:#0009}.preview{border:2px solid #176c62;padding:10px}code{overflow-wrap:anywhere} [hidden]{display:none!important}
</style>
<header><h1>ニュースの現在地・運営者確認</h1><div>隔離試作｜本番への反映なし</div><div id="counts" aria-live="polite">読込中</div></header><main>
<p class="warning">この端末内の一時SQLiteだけを操作します。実際の記事取得・AI通信・本番公開は行いません。判断記録は正解データへ自動反映しません。</p>
<nav><button id="listTab">確認一覧</button><button id="previewTab">公開プレビュー</button><button id="historyTab">操作履歴</button></nav>
<p id="message" role="status" class="message" aria-live="polite"></p><button id="reload">再読込</button><button id="export">確認記録をJSON保存</button><div id="content"></div>
</main><dialog id="confirmDialog"><h2 id="confirmTitle">操作の確認</h2><pre id="confirmContent"></pre><p>対象・根拠を確認してください。本番には反映されません。</p><label>理由<textarea id="confirmReason" placeholder="根拠を確認した理由／取消し理由"></textarea></label><button id="confirmYes" class="primary">確認して実行</button><button id="confirmNo">戻る</button></dialog>
<dialog id="previewDialog"><h2>承認前・仮承認後の比較</h2><p>仮のプレビューです。承認記録は保存されません。</p><pre id="previewContent"></pre><button id="closePreview">閉じる</button></dialog>
<script id="offlineSnapshot" type="application/json">null</script>
<script>
'use strict';
const OFFLINE_DATA=JSON.parse(document.getElementById('offlineSnapshot').textContent);const TOKEN='__LOCAL_TOKEN__'; let state=null,busy=false,tab='list',selected=null,pending=null,queueLimit=20;
const $=id=>document.getElementById(id);
function el(tag,text,parent){const n=document.createElement(tag);if(text!==undefined)n.textContent=typeof text==='string'?text:JSON.stringify(text,null,2);if(parent)parent.append(n);return n;}
function note(text){$('message').textContent=text;}
function button(text,fn,parent,cls){const b=el('button',text,parent);b.type='button';if(cls)b.className=cls;b.onclick=fn;return b;}
function details(label,value,parent){const d=el('details',undefined,parent);el('summary',label,d);el('pre',value,d);return d;}
function link(url,parent){try{const u=new URL(url);if(!['http:','https:'].includes(u.protocol))return;const a=el('a',url,parent);a.href=u.href;a.target='_blank';a.rel='noopener noreferrer';a.onclick=e=>{if(!confirm('外部の記事URLを開きます。本文は自動取得しません。開きますか？'))e.preventDefault();};}catch{el('p','URLを確認できません',parent);}}
function draftKey(eid){return 'news-now-local-ui:reason:'+eid;}
function loadDraft(eid){try{return localStorage.getItem(draftKey(eid))||'';}catch{return '';}}
function saveDraft(eid,v){try{localStorage.setItem(draftKey(eid),v);}catch{note('端末内の下書き保存が使えません。操作記録はSQLiteへ保存されます。');}}
async function refresh(){if(OFFLINE_DATA){state=OFFLINE_DATA;note('読み取り専用HTMLです。操作の保存・承認には端末内ローカルサーバーが必要です。');render();return;}if(busy)return;try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw Error('読込失敗');state=await r.json();render();}catch(e){note('ローカルサーバーに接続できません。起動状態を確認してください。');}}
async function send(command){if(OFFLINE_DATA)return note('読み取り専用HTMLでは保存・承認できません。ローカルサーバーで開いてください。');if(busy)return;busy=true;const disabled=Array.from(document.querySelectorAll('button'),b=>[b,b.disabled]);disabled.forEach(([b])=>b.disabled=true);try{
 const payload={...command,revision:state.revision,op:crypto.randomUUID()};
 // Persist the exact command before sending. Retry never generates a new ID.
 sessionStorage.setItem('news-now-ui-pending',JSON.stringify(payload));await post(payload);
}catch(e){note(e.message+'。再読込後「未完了操作を再送」で同じ操作IDを使用できます。');}finally{busy=false;disabled.forEach(([b,value])=>b.disabled=value);render();}}
async function post(payload){const r=await fetch('/api/operate',{method:'POST',headers:{'Content-Type':'application/json','X-Local-Token':TOKEN},body:JSON.stringify(payload)});const data=await r.json();if(!r.ok){if(r.status<500)sessionStorage.removeItem('news-now-ui-pending');throw Error(data.error||'停止しました');}sessionStorage.removeItem('news-now-ui-pending');state=data.state;note('隔離SQLiteへ保存しました。公開には別途、項目ごとの承認が必要です。');}
async function preview(item,t){if(OFFLINE_DATA)return note('仮承認プレビューはローカルサーバーでのみ利用できます。');if(busy)return;busy=true;try{const r=await fetch('/api/preview',{method:'POST',headers:{'Content-Type':'application/json','X-Local-Token':TOKEN},body:JSON.stringify({revision:state.revision,event_id:item.event.event_id,kind:t.kind,key:t.key})});const data=await r.json();if(!r.ok)throw Error(data.error);$('previewContent').textContent=JSON.stringify(data.result,null,2);$('previewDialog').showModal();}catch(e){note(e.message);}finally{busy=false;}}
$('closePreview').onclick=()=>$('previewDialog').close();
function ask(item,t,action){if(OFFLINE_DATA)return note('読み取り専用HTMLです。承認はできません。');pending={item,t,action};$('confirmTitle').textContent=action==='withdraw'?'公開取消しの確認':'公開承認・再承認の確認';$('confirmContent').textContent=JSON.stringify({事件:item.event.event_name,事件ID:item.event.event_id,対象:t.kind,内容:t.content,判断ID:t.decision_ids,根拠ID:t.evidence_ids,現在の承認:t.status},null,2);$('confirmReason').value='';$('confirmDialog').showModal();}
function render(){if(!state)return;$('content').replaceChildren();$('counts').textContent='待機・判定記録 '+state.queues.length+'組｜事件 '+state.items.length+'件｜承認待ち項目 '+state.items.flatMap(x=>x.targets).filter(t=>t.status!=='approved').length+'件｜再確認判断 '+state.items.flatMap(x=>x.judgments).filter(j=>j.status==='needs_recheck').length+'件';
 let saved;try{saved=sessionStorage.getItem('news-now-ui-pending');}catch{}if(saved)button('未完了操作を同じIDで再送',async()=>{if(busy)return;busy=true;try{await post(JSON.parse(saved));}catch(e){note(e.message);}finally{busy=false;render();}},$('content'));
 if(tab==='preview'){el('h2','承認済み出力のプレビュー',$('content'));el('p','既存の公開承認エンジンが生成したJSONをそのまま表示します。比較用JSONは読み込みません。',$('content'));const p=el('section',undefined,$('content'));p.className='preview';if(!state.approved_preview.length)el('p','公開可能な事件は0件です。事件と、根拠で参照したすべての記事の承認が必要です。',p);for(const e of state.approved_preview){el('h3',e.event_name,p);el('p',e.current_stage+' ／ '+e.summary,p);details('承認済み公開JSON',e,p);}details('取消し・公開状態のお知らせ',state.notices,$('content'));return;}
 if(tab==='history'){el('h2','承認・取消し履歴',$('content'));details('公開操作履歴',state.history,$('content'));details('保存済み運営者判断の原記録（未再検証）',state.legacy_operator_records,$('content'));for(const item of state.items){details(item.event.event_name+'：判断履歴',item.judgments,$('content'));details('運営者確認記録（正解データとは別）',item.reviews,$('content'));}return;}
 if(!selected){
 el('h2','保存済みの待機・判定記録',$('content'));
 for(const q of state.queues.slice(0,queueLimit)){const a=el('article',undefined,$('content'));el('h3',q.group.event_name||'事件名未確認',a);el('small',q.stage+' ／ 保存時の状態：'+q.source_status,a);if(q.source_reason)el('p',q.source_reason,a);
 for(const article of q.group.articles){el('p',article.title,a);el('p',(article.published||'日時未確認')+' ／ '+(article.source||article.publisher||'媒体未確認'),a);link(article.url,a);}
 const select=el('select',undefined,a);el('option','候補を選択（未選択でも保留可能）',select).value='';for(const c of q.candidates){const item=state.items.find(i=>i.event.event_id===c.event_id);el('option',(item?.event.event_name||c.event_id)+' ／ '+c.event_id,select).value=c.event_id;}
 details('全候補・順位・根拠（候補は削除しません）',q.candidates,a);details('過去の確認記録',q.records,a);el('p','根拠不足時は保留してください。判断記録だけで採用されません。',a).className='warning';
 const reason=el('textarea',undefined,a);reason.placeholder='判断・保留理由';reason.value=loadDraft(q.queue_id);reason.oninput=()=>saveDraft(q.queue_id,reason.value);
 for(const text of ['本文未確認','引用不足','別事件の疑い'])button(text,()=>{reason.value=text;saveDraft(q.queue_id,text);},a);
 for(const [text,result] of [['同一事件','same_event'],['別事件','different_event'],['保留','hold']])button(text,()=>send({action:'queue_review',queue_id:q.queue_id,event_id:select.value||null,result,reason:reason.value}),a);
 button('選択した事件・根拠を確認',()=>{if(select.value){selected=select.value;render();}else note('事件候補を選んでください。');},a);}
 if(queueLimit<state.queues.length)button('次の20組を表示（残り '+(state.queues.length-queueLimit)+'組）',()=>{queueLimit+=20;render();},$('content'));
 el('h2','事件と公開承認待ち',$('content'));
 for(const item of state.items){const a=el('article',undefined,$('content'));el('h2',item.event.event_name,a);el('p',item.event.current_stage||'現在地未確認',a);el('span','承認待ち '+item.targets.filter(t=>t.status!=='approved').length+'項目',a).className='badge';button('記事・根拠を確認',()=>{selected=item.event.event_id;render();},a,'primary');}return;}
 const item=state.items.find(x=>x.event.event_id===selected);if(!item){selected=null;return render();}button('← 一覧へ',()=>{selected=null;render();},$('content'));el('h2',item.event.event_name,$('content'));el('p','事件ID：'+item.event.event_id,$('content'));
 for(const x of item.articles){const a=el('article',undefined,$('content'));el('h3',x.article.title,a);el('p',(x.article.published||'日時未確認')+' ／ '+(x.article.source||x.article.publisher||'媒体未確認'),a);link(x.article.url,a);el('p','本文取得状態：'+(x.version?.availability||'未取得・未確認'),a);details('記事版・内容ハッシュ',x.version,a);if(!x.evidence.length)el('p','根拠不足：保存された引用はありません。',a).className='warning';for(const ev of x.evidence){el('blockquote',ev.quote||'引用未提供',a);el('small',ev.field+' ／ '+ev.verification.status,a);} }
 const review=el('section',undefined,$('content'));review.className='card';el('h2','事件との関係を記録',review);el('p','この記事群と表示中の事件との関係を記録します。統合・採用・公開承認は自動実行しません。',review);const label=el('label','判断理由・保留理由',review);const reason=el('textarea',undefined,label);reason.value=loadDraft(selected);reason.oninput=()=>saveDraft(selected,reason.value);for(const text of ['本文未確認','引用不足','別事件の疑い','記事が削除されている'])button(text,()=>{reason.value=text;saveDraft(selected,text);},review);
 for(const [text,result] of [['同一事件','same_event'],['別事件','different_event'],['保留','hold']])button(text,()=>send({action:'review',event_id:item.event.event_id,result,reason:reason.value,group:{articles:item.event.articles}}),review);
 details('判断ID・再確認状態',item.judgments,review);details('記事改訂・訂正履歴',item.event.source_revisions||[],review);details('保存済みの進展・予定',{進展:item.event.progress_history||[],予定:item.event.schedules||[]},review);details('これまでの確認記録',item.reviews,review);
 el('h2','項目ごとの公開承認',$('content'));el('p','承認前：未承認の内容は公開に出ません。以下は内部確認用です。承認後は「公開プレビュー」で確認できます。',$('content'));
 const names={event:'事件',field:'現在地・表示項目',article:'記事',progress:'進展',schedule:'予定',correction:'訂正',revision:'記事改訂'};
 for(const t of item.targets){const a=el('article',undefined,$('content'));el('h3',(names[t.kind]||t.kind)+'：'+(t.kind==='field'?t.key:'')+' ／ '+t.status,a);details('承認対象の内容（公開前の内部表示）',t.content,a);if(t.warning)el('p','安全停止：'+t.warning,a).className='warning';const b=button(t.approval_id?'再承認':'公開承認',()=>ask(item,t,'approve'),a,'primary');b.disabled=!t.ready||t.status==='approved';if(t.ready&&t.status!=='approved')button('承認前・仮承認後を比較',()=>preview(item,t),a);if(t.approval_id&&t.status!=='withdrawn')button('公開取消し',()=>ask(item,t,'withdraw'),a,'danger');details('判断ID・根拠・承認ID',t,a);}
}
$('listTab').onclick=()=>{tab='list';selected=null;render();};$('previewTab').onclick=()=>{tab='preview';render();};$('historyTab').onclick=()=>{tab='history';render();};$('reload').onclick=refresh;
$('confirmNo').onclick=()=>{$('confirmDialog').close();pending=null;};$('confirmYes').onclick=()=>{if(!pending||busy)return;if(!$('confirmReason').value.trim())return note('理由を入力してください。');const {item,t,action}=pending;const command={action,event_id:item.event.event_id,kind:t.kind,key:t.key,confirmed:true,reason:$('confirmReason').value};pending=null;$('confirmDialog').close();send(command);};
$('export').onclick=()=>{if(!state)return;const record={scope:'isolated_review_only_not_authority',revision:state.revision,reviews:state.items.map(i=>({event_id:i.event.event_id,reviews:i.reviews,judgments:i.judgments})),queues:state.queues.map(q=>({queue_id:q.queue_id,records:q.records})),history:state.history};const blob=new Blob([JSON.stringify(record,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='news-now-local-review-records.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};
refresh();
</script></html>
