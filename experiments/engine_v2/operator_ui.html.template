<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ニュースの現在地・今日の確認作業</title>
<style>
:root{font:17px/1.6 system-ui,sans-serif;color:#183432;background:#f1f5f3}*{box-sizing:border-box}body{margin:0}header{position:sticky;top:0;z-index:2;background:#15473f;color:#fff;padding:7px 14px;display:flex;align-items:center;justify-content:space-between;gap:8px}h1{font-size:17px;margin:0}header small{color:#e1f5eb;font-size:12px}main{max-width:720px;margin:auto;padding:12px 12px 90px}h2{font-size:23px;line-height:1.4;margin:14px 0}h3{font-size:19px;line-height:1.5;margin:10px 0}p{margin:8px 0}button,input,textarea,select{font:inherit;min-height:48px;border:1px solid #668078;border-radius:10px;max-width:100%;padding:10px}button{cursor:pointer;background:#fff;color:#17483f;margin:4px 4px 4px 0}button.primary{background:#176b56;color:#fff}button.danger{border-color:#a53736;color:#a53736}button[aria-pressed=true]{background:#d7f1df;border:2px solid #176b56}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible{outline:3px solid #c68105;outline-offset:2px}input[type=checkbox]{width:24px;height:24px;min-height:24px;flex:none}select,textarea{width:100%}textarea{min-height:80px}article,.card{background:#fff;border:1px solid #d2ded8;border-radius:14px;padding:14px;margin:12px 0}.warning{background:#fff2d5;border-left:4px solid #c18516;padding:10px;border-radius:4px}.safe{background:#dfefe5;padding:10px}.muted,small{color:#52685e}a{color:#006a66;overflow-wrap:anywhere}details{margin:10px 0}summary{min-height:44px;padding:8px 0;cursor:pointer}pre,code{font:13px/1.6 monospace;overflow-wrap:anywhere;white-space:pre-wrap}pre{background:#f1f4f2;padding:9px}blockquote{border-left:3px solid #6b9a89;margin:8px 0;padding:6px 10px;background:#f3f7f4}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tile{text-align:left;min-height:118px;margin:0;padding:12px}.tile strong{display:block;font-size:30px}.row{display:flex;gap:7px;flex-wrap:wrap}.choices{display:grid;gap:5px}.choices button{text-align:left;width:100%;margin:0}.badge{display:inline-block;padding:3px 10px;border-radius:18px;background:#e3eee7;font-size:14px}label.check{display:flex;gap:10px;align-items:center;min-height:52px;border-bottom:1px solid #e1e8e3;padding:8px 0}label{display:block;margin:7px 0}.bar{position:fixed;bottom:0;left:0;right:0;z-index:2;background:#ffffffed;border-top:1px solid #d2ded8;padding:6px 12px;display:flex;justify-content:center;gap:8px}.bar button{margin:0}.notice{white-space:pre-wrap}dialog{width:min(94vw,640px);max-height:88vh;border:1px solid #68867a;border-radius:14px;padding:16px;overflow:auto}dialog::backdrop{background:#0008}[hidden]{display:none!important}.preview{border:2px solid #478a6a;padding:12px;border-radius:10px}.step{font-size:14px;font-weight:bold;color:#406952}.risk{color:#953428;font-weight:bold}
@media(max-width:380px){:root{font-size:16px}.tile{padding:10px}.bar button{font-size:15px;padding:8px}}
</style></head><body>
<header><h1>ニュースの現在地</h1><small id="mode">端末内の操作練習</small></header>
<main><p id="notice" class="notice" role="status" aria-live="polite"></p><div id="content"></div><details id="errorDetails" hidden><summary>詳しい停止理由</summary><pre id="errorText"></pre></details></main>
<div class="bar"><button id="home">今日の作業へ</button><button id="reload">再読込</button><button id="history">確認済み・履歴</button></div>
<dialog id="confirmDialog"><h2 id="confirmTitle">公開内容の最終確認</h2><div id="confirmBody"></div><label>確認した理由<textarea id="confirmReason" placeholder="根拠と表示内容を確認しました"></textarea></label><div class="row"><button id="confirmYes" class="primary">確認して実行</button><button id="confirmNo">戻る</button></div></dialog>
<dialog id="previewDialog"><h2>仮承認後の公開プレビュー</h2><p class="warning">確認用です。承認はまだ保存されていません。</p><div id="previewBody"></div><button id="closePreview">閉じる</button></dialog>
<script id="offlineSnapshot" type="application/json">null</script>
<script>
'use strict';
const OFFLINE_DATA=JSON.parse(document.getElementById('offlineSnapshot').textContent);
const TOKEN='__LOCAL_TOKEN__';
const $=id=>document.getElementById(id);
const LABEL={unknown:'未確認',unapproved:'未承認',approved:'承認済み',needs_recheck:'再確認が必要',withdrawn:'公開取消し済み',superseded:'新しい確認へ更新済み',current:'現在の判断',cancelled:'取り消された判断',accepted:'安全検証を通過（正解確認ではありません）',active:'追跡中',review:'確認中',completed:'完結',dormant:'休眠中',available:'保存本文あり・出典確認は未検証',deleted:'削除が記録されています',empty_body:'本文が空です',request_failed:'取得に失敗しています',current_stage:'現在の進展段階',lifecycle:'追跡状態',summary:'事件の概要',updated_at:'最終更新日時',latest:'最新の動き',next_watch:'今後の確認点',exact_literal_match:'保存内容との文字列一致',stale_source:'記事が変わったため再確認が必要',not_provided:'引用なし',literal_mismatch:'保存内容と引用が一致しません',body:'本文',title:'見出し',description:'記事の紹介文',published:'公開日時',metadata:'記事の版',availability:'取得状態',same_event:'同じ事件',different_event:'別の事件',hold:'判断できない・保留',new:'新しい進展あり',none:'新しい進展なし',possible_correction:'訂正・撤回の可能性',not_requested:'訂正の判断なし',operator_reported_new:'新しい進展の確認記録・安全検証待ち',already_recorded_literal_candidate:'既存の引用と同じ内容を含むため重複報道の候補',needs_evidence:'進展の根拠が不足・要確認',operator_reported_no_change:'新しい進展なしの確認記録',not_reviewed:'進展は未確認'};
const CATEGORIES={identity:'事件の判定待ち',progress:'続報・進展の確認待ち',publication:'公開の確認待ち',hold:'保留・再確認が必要'};
let state=null,busy=false,view={page:'home'},choice=null,selectedTargets=new Set(),pending=null,lastResult=null;
function el(tag,text,parent){const n=document.createElement(tag);if(text!==undefined)n.textContent=typeof text==='string'?text:JSON.stringify(text,null,2);if(parent)parent.append(n);return n;}
function note(text){$('notice').textContent=text;}
function jp(value){return LABEL[value]||'詳細情報で確認';}
function date(value){if(!value)return '未確認';const d=new Date(value);if(Number.isNaN(d.getTime()))return '未確認';const p=Object.fromEntries(new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',year:'numeric',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d).map(x=>[x.type,x.value]));return `${p.year}年${p.month}月${p.day}日 ${p.hour}:${p.minute}`;}
function button(text,fn,parent,cls=''){const b=el('button',text,parent);b.type='button';b.className=cls;b.onclick=fn;return b;}
function detail(label,value,parent){const d=el('details',undefined,parent);el('summary',label,d);el('pre',value,d);return d;}
function link(url,parent){try{const u=new URL(url);if(!['http:','https:'].includes(u.protocol))return;const a=el('a','記事を開く（外部サイト）',parent);a.href=u.href;a.target='_blank';a.rel='noopener noreferrer';a.onclick=e=>{if(!confirm('外部の記事を開きます。本文の自動取得はしません。開きますか？'))e.preventDefault();};}catch{el('p','記事URLは未確認です。',parent);}}
function go(next){view=next;choice=null;selectedTargets=new Set();render();window.scrollTo(0,0);}
function draft(id){try{return localStorage.getItem('news-now-reason:'+id)||'';}catch{return '';}}
function saveDraft(id,v){try{localStorage.setItem('news-now-reason:'+id,v);}catch{note('この端末では下書きの保存が使えません。');}}
function fail(error){note('安全のため停止しました。'+(/[^\x00-\x7F]/.test(error.message)?error.message:'根拠や判断の条件を確認してください。'));$('errorDetails').hidden=false;$('errorText').textContent=error.message;}
async function refresh(){if(busy)return;if(OFFLINE_DATA){state=OFFLINE_DATA;note((state.data_scope==='synthetic_demo'?'架空データの':'保存済みデータ（未再検証）の')+'閲覧専用画面です。選択して表示を試せますが、判断・承認は保存できません。');render();return;}try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw Error('読込できませんでした。');state=await r.json();render();}catch(e){fail(e);}}
async function request(path,command){const r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json','X-Local-Token':TOKEN},body:JSON.stringify(command)});const data=await r.json();if(!r.ok)throw Error(data.error||'処理を停止しました。');return data;}
async function post(command,next){if(OFFLINE_DATA)return note('閲覧専用です。判断・承認・取消しは保存できません。');if(busy)return;busy=true;const disabled=Array.from(document.querySelectorAll('button'),b=>[b,b.disabled]);disabled.forEach(([b])=>b.disabled=true);try{const payload={...command,revision:state.revision,op:crypto.randomUUID()};sessionStorage.setItem('news-now-work-pending',JSON.stringify(payload));const data=await request('/api/operate',payload);sessionStorage.removeItem('news-now-work-pending');state=data.state;lastResult=data.result;note(command.action==='task_review'?'確認記録を保存しました。統合・進展確定・公開はまだ行っていません。':'項目ごとの安全検証を通して保存しました。');if(next?.nextTask){const t=state.work.tasks.find(t=>t.category===next.category&&t.task_id!==command.task_id);view=t?(t.article?{page:'review',taskId:t.task_id,category:t.category,returnOffset:view.offset||0}:{page:'publication',eventId:t.event_id,category:t.category,returnOffset:view.offset||0}):{page:'list',category:next.category};}else if(next)view=next;choice=null;selectedTargets.clear();}catch(e){fail(e);}finally{busy=false;disabled.forEach(([b,v])=>b.disabled=v);render();}}
function item(eid){return state.items.find(i=>i.event.event_id===eid);}
function task(id){return state.work.tasks.find(t=>t.task_id===id);}
function title(t){return t.article?.title||item(t.event_id)?.event.event_name||'確認作業';}
function targetName(t){return t.kind==='event'?'事件名・分類':t.kind==='field'?jp(t.key):({article:'根拠記事',progress:'進展の記録',schedule:'今後の予定',correction:'訂正・注意事項',revision:'記事の更新履歴'})[t.kind]||'公開項目';}
function targetId(t){return JSON.stringify([t.kind,t.key]);}
function reader(event,parent,unapproved=false){const p=el('section',undefined,parent);p.className='preview';if(unapproved)el('p','公開前の確認用・未承認です。この表示のまま公開できません。',p).className='warning';el('h3',event.event_name,p);el('p','概要：'+(event.summary||'確認中'),p);el('p','現在地：'+(event.current_stage||'確認中'),p);el('h3','進展の時系列',p);timeline(event,p);el('h3','根拠記事',p);for(const a of event.articles||[]){el('p',a.title,p);el('small','報道の公開日時：'+date(a.published)+'（日本時間）',p);link(a.url,p);}el('h3','訂正・注意事項',p);if(!(event.corrections||[]).length)el('p','この表示に含まれる訂正記録はありません。未確認情報がないことの証明ではありません。',p);for(const c of event.corrections||[])el('p',c.reason||c.summary||c.note||'訂正の詳細を確認してください。',p);}
function timeline(event,parent){const rows=event.progress_history||[];if(!rows.length)el('p','記録された重要な進展はありません。',parent);for(const row of rows.slice(-4)){el('p','・'+(row.stage||row.current_stage||'進展の記録'),parent);el('small','報道の公開日時：'+date(row.source_at||row.at)+' ／ 出来事の発生日時：'+date(row.event_occurred_at),parent);}if(rows.length>4)detail('すべての経過（詳細情報）',rows,parent);}
function dashboard(parent){el('h2','今日の確認作業',parent);el('p',state.data_scope==='synthetic_demo'?'架空の操作例です。件数は実運用の値ではありません。':'読み込んだ保存データの集計です。本番の最新状況ではありません。',parent).className='muted';el('p','優先：訂正・再確認 → 事件の確認 → 進展の確認 → 公開の確認',parent);const grid=el('div',undefined,parent);grid.className='grid';for(const [key,name] of Object.entries(CATEGORIES)){const b=button('',()=>go({page:'list',category:key}),grid,'tile');el('span',name,b);el('strong',state.work.counts[key]+'件',b);}el('p','同じ記事の重複や過去の記録は件数に含めません。共有記事は事件ごと、公開確認は事件ごとの作業です。',parent).className='muted';const next=state.work.tasks[0];if(next){const a=el('article',undefined,parent);el('span','先に確認したい作業',a).className='badge';el('h3',title(next),a);el('p',next.reason,a);button('この1件を確認する',()=>openTask(next),a,'primary');}else el('p','現在、人による未処理の確認作業はありません。',parent).className='safe';detail('自動処理待ち・過去記録について',{自動処理待ち:state.work.ai_waiting,一覧から除外した過去記録:state.work.excluded_history,集計単位:state.work.unit},parent);if(OFFLINE_DATA)el('p','閲覧専用です。判断や承認を選んでも保存されません。',parent).className='warning';}
function openTask(t){go(t.article?{page:'review',taskId:t.task_id,category:t.category,returnOffset:view.offset||0}:{page:'publication',eventId:t.event_id,category:t.category,returnOffset:view.offset||0});}
function list(parent){el('h2',CATEGORIES[view.category],parent);const rows=state.work.tasks.filter(t=>t.category===view.category);if(!rows.length)el('p','この種類の未処理作業はありません。',parent);const offset=view.offset||0;for(const t of rows.slice(offset,offset+20)){const a=el('article',undefined,parent);el('h3',title(t),a);if(t.required_event_id)el('p','確認対象：'+item(t.required_event_id).event.event_name,a);el('p',t.reason,a);el('small',t.priority===0?'優先して再確認':'人による確認が必要',a);button('確認する',()=>openTask(t),a,'primary');}if(offset>0)button('前の20件',()=>go({...view,offset:Math.max(0,offset-20)}),parent);if(offset+20<rows.length)button('次の20件',()=>go({...view,offset:offset+20}),parent);if(rows.length)el('p',(offset+1)+'〜'+Math.min(offset+20,rows.length)+'件目 ／ 全'+rows.length+'件',parent);}
function quotePanel(t,eid,parent){const a=el('section',undefined,parent);a.className='card';el('h3','判断の根拠と注意点',a);const source=t.source;el('p',!source||source.availability==='unknown'?'本文未確認':jp(source.availability),a).className='warning';const proofs=t.evidence_by_event?.[eid]||[];const quotes=proofs.filter(p=>p.quote);if(!quotes.length)el('p','保存された引用がありません。推測せず「判断できない・保留」を選んでください。',a).className='warning';for(const p of quotes){el('blockquote',p.quote,a);const matched=p.verification.status==='exact_literal_match';el('p',p.field==='title'&&matched?'見出し一致・原文未確認':p.field==='body'&&matched?'保存本文との文字列一致・出典確認は未検証':jp(p.verification.status),a);detail('引用の詳細情報',p,a);}if(t.correction_hint)el('p','見出しに訂正・撤回を示す語があります。通常の進展として確定せず、訂正の可能性を確認してください。',a).className='warning';if(t.fetch_wait)el('p','記事の取得に失敗した記録があります。保存本文があっても再確認してください。',a).className='warning';if(t.edition_conflict){el('p','同じURLの複数の記事版があり、現在版を確認できません。保留してください。',a).className='warning';for(const v of t.article_variants){el('p','版の候補：'+v.title,a);el('small','報道の公開日時：'+date(v.published),a);}}if(t.shared_event_ids.length)el('p','この1記事は複数の事件に対応しています。記事が同じでも事件は統合しません。対象の事件ごとに確認してください。',a).className='warning';if(t.source_changed)el('p','記事の更新が記録されています。以前の判断はそのまま使えません。',a).className='warning';el('p','矛盾がないと保証された記事ではありません。対象の人物・場所・時期の食い違いも確認してください。',a);}
function review(parent){const t=task(view.taskId);if(!t||!t.article){note('この作業は確認済みか更新されています。一覧へ戻ってください。');return;}button('← 元の一覧へ',()=>go({page:'list',category:view.category,offset:view.returnOffset||0}),parent);el('h2','記事を1件ずつ確認',parent);el('p',t.reason,parent).className='warning';if(!choice||choice.taskId!==t.task_id)choice={taskId:t.task_id,eid:t.record?.event_id||t.suggested_event_id,relation:null,progress:null,proposed_stage:null,reason:draft(t.task_id)};
 const compare=el('section',undefined,parent);compare.className='card';el('p','比較する追跡中の事件',compare).className='step';const select=el('select',undefined,compare);el('option','候補を選択してください',select).value='';for(const c of t.candidates){const e=item(c.event_id)?.event;el('option',e?.event_name||'事件名未確認',select).value=c.event_id;}select.value=choice.eid||'';select.disabled=Boolean(t.required_event_id);select.onchange=()=>{choice.eid=select.value||null;choice.relation=null;choice.progress=null;render();};const e=item(choice.eid)?.event;if(e){el('h3',e.event_name,compare);el('p','現在の進展段階：'+(e.current_stage||'未確認'),compare);el('h3','これまでの重要な経過',compare);timeline(e,compare);const reference=e.articles?.find(a=>a.url!==t.article.url);if(reference)el('p','追跡中の記事：'+reference.title,compare);}
 const incoming=el('section',undefined,parent);incoming.className='card';el('p','新しく見つかった記事',incoming).className='step';el('h3',t.article.title,incoming);el('p',(t.article.source||t.article.publisher||'媒体名未確認')+' ／ '+date(t.article.published)+'（日本時間）',incoming);el('p','出来事の発生日時：未確認。記事の公開日時とは区別します。',incoming);link(t.article.url,incoming);el('h3','候補が表示された理由',incoming);const c=t.candidates.find(c=>c.event_id===choice.eid);el('p',c?.reasons?.operator_target?'保存済みの運営者指定があります。同一事件の証明ではありません。':c?.reasons?.known_url?'同じURLが保存されています。内容の改訂や複数事件への対応を確認してください。':'保存記事との言葉の重なりなどによる検索候補です。同じ事件と確定した結果ではありません。',incoming);el('p',t.ai_records.length?'保存済みAI判断があります。正解として扱わず根拠を確認してください。':'この記事について、保存されたAI判断は確認できません。実AIは呼び出していません。',incoming);detail('候補・記事版・判断IDなどの詳細情報',t,incoming);
 quotePanel(t,choice.eid,parent);for(const p of t.publication_rechecks||[])button('この事件の公開内容も再確認する',()=>go({page:'publication',eventId:p.event_id,category:'hold'}),parent);const form=el('section',undefined,parent);form.className='card';el('h3','第1段階：同じ事件ですか？',form);const relationBox=el('div',undefined,form);relationBox.className='choices';const second=el('div',undefined,form);const saveArea=el('div',undefined,form);
 function draw(){relationBox.replaceChildren();second.replaceChildren();saveArea.replaceChildren();for(const [label,value] of [['同じ事件','same_event'],['別の事件','different_event'],['判断できない・保留','hold']]){const b=button(label,()=>{choice.relation=value;if(value!=='same_event')choice.progress=null;draw();},relationBox);b.setAttribute('aria-pressed',String(choice.relation===value));}if(choice.relation==='same_event'){el('h3','第2段階：新しい進展がありますか？',second);el('p','同じ事件という確認だけでは、進展を確定しません。すでに記録済みの進展や訂正と区別してください。',second);const box=el('div',undefined,second);box.className='choices';for(const [label,value] of [['同じ事件の続報・新しい進展あり','new'],['同じ事件だが新しい進展なし','none'],['進展の有無が不明・要確認','unknown'],['過去の報道内容の訂正・撤回の可能性あり','possible_correction']]){const b=button(label,()=>{choice.progress=value;draw();},box);b.setAttribute('aria-pressed',String(choice.progress===value));}if(choice.progress==='new'){const label=el('label','記事に書かれた進展段階（引用で確認してください）',second);const stage=el('select',undefined,label);el('option','進展段階を選択',stage).value='';for(const name of ['逮捕','送検','起訴','判決','施行','復旧','その他・不明'])el('option',name,stage).value=name;stage.value=choice.proposed_stage||'';stage.onchange=()=>{choice.proposed_stage=stage.value||null;};}if(e?.progress_history?.length)el('p','記録済みの進展：'+e.progress_history.slice(-3).map(p=>p.stage||'進展').join(' → ')+'。同じ起訴などの重複報道を新しい進展として追加しません。',second);if(choice.progress==='possible_correction')el('p','訂正の疑いとして別の確認記録に残し、安全のため公開承認を停止します。通常の進展には追加しません。',second).className='warning';}
 const label=el('label','判断・保留の理由',saveArea);const reason=el('textarea',undefined,label);reason.value=choice.reason;reason.placeholder='何が確認できたか・何が不足しているか';reason.oninput=()=>{choice.reason=reason.value;saveDraft(t.task_id,reason.value);};for(const text of ['本文未確認','引用が不足','時期・場所が不明','既に記録された進展','訂正の可能性'])button(text,()=>{choice.reason=text;reason.value=text;saveDraft(t.task_id,text);},saveArea);
 const b=button(OFFLINE_DATA?'閲覧専用：記録は保存できません':'確認記録を保存して次へ',()=>submit(false),saveArea,'primary');b.disabled=Boolean(OFFLINE_DATA)||!choice.relation||(choice.relation==='same_event'&&!choice.progress);if(choice.relation==='same_event'&&!choice.progress){const first=button('事件の確認だけ記録し、進展は後で確認',()=>submit(true),saveArea);first.disabled=Boolean(OFFLINE_DATA);} }
 function submit(first){post({action:'task_review',task_id:t.task_id,context_hash:t.context_hash,event_id:choice.eid,relation:choice.relation,progress:first?null:choice.progress,proposed_stage:choice.proposed_stage,reason:choice.reason},{nextTask:true,category:view.category});}draw();if(t.record)detail('前回の確認記録（詳細情報）',t.history,parent);}
function selected(item){return item.targets.filter(t=>selectedTargets.has(targetId(t))).map(t=>({kind:t.kind,key:t.key,content_hash:t.content_hash}));}
async function bundlePreview(i){if(OFFLINE_DATA)return note('閲覧専用では仮承認を実行できません。');if(busy)return;busy=true;try{const data=await request('/api/preview-bundle',{revision:state.revision,event_id:i.event.event_id,targets:selected(i),reason:'公開前の仮確認'});$('previewBody').replaceChildren();if(!data.result.events.length)el('p','選んだ項目だけでは公開できません。事件と引用元の記事がすべて承認対象に入っているか確認してください。',$('previewBody'));for(const e of data.result.events)reader(e,$('previewBody'));detail('項目ごとの検証結果',data.result.results,$('previewBody'));$('previewDialog').showModal();}catch(e){fail(e);}finally{busy=false;}}
function ask(command,title,entries){if(OFFLINE_DATA)return note('閲覧専用のため保存できません。');pending=command;$('confirmTitle').textContent=title;$('confirmBody').replaceChildren();for(const t of entries){el('h3',targetName(t),$('confirmBody'));showTarget(t,$('confirmBody'));detail('根拠・判断・承認対象の詳細情報',t,$('confirmBody'));}$('confirmReason').value='';$('confirmDialog').showModal();}
function showTarget(t,parent){if(t.kind==='field')el('p',t.key==='updated_at'?date(t.content):t.key==='lifecycle'?jp(t.content):String(t.content),parent);else if(t.kind==='event')el('p',t.content.event_name||'事件名未確認',parent);else if(t.kind==='article'){el('p',t.content.title,parent);el('small','公開日時：'+date(t.content.published),parent);}else if(t.kind==='progress')el('p',(t.content.stage||'進展')+' ／ 報道日時：'+date(t.content.source_at||t.content.at),parent);else if(t.kind==='schedule')el('p',t.content.title||t.content.description||'予定の内容を詳細情報で確認してください。',parent);else el('p',t.content.reason||t.content.summary||t.content.note||'内容を詳細情報で確認してください。',parent);}
function publication(parent){const i=item(view.eventId);if(!i)return;button('← 元の一覧へ',()=>go({page:'list',category:view.category||'publication',offset:view.returnOffset||0}),parent);el('h2','公開してよい内容か確認',parent);reader(i.event,parent,true);el('h3','今回、確認する内容を選択',parent);el('p','内部では項目ごとに、記事版・引用・判断を検証します。チェックだけでは承認されません。',parent);button('安全検証を通せる未承認項目を選択',()=>{selectedTargets=new Set(i.targets.filter(t=>t.ready&&t.status!=='approved').map(targetId));render();},parent);for(const t of i.targets){const a=el('article',undefined,parent);const l=el('label',undefined,a);l.className='check';const check=el('input',undefined,l);check.type='checkbox';check.checked=selectedTargets.has(targetId(t));check.disabled=!t.ready||t.status==='approved';check.onchange=()=>{if(check.checked)selectedTargets.add(targetId(t));else selectedTargets.delete(targetId(t));};el('span',targetName(t)+' ／ '+jp(t.status),l);showTarget(t,a);if(!t.ready)el('p','根拠・記事版・現在の判断が揃っていないため停止しています。',a).className='warning';detail('詳細情報（承認対象・根拠・停止理由）',t,a);if(t.approval_id&&t.status!=='withdrawn'){const b=button('この内容の公開を取り消す',()=>ask({action:'withdraw',event_id:i.event.event_id,kind:t.kind,key:t.key},'公開取消しの確認',[t]),a,'danger');b.disabled=Boolean(OFFLINE_DATA);}}
 const preview=button('選んだ内容の公開前プレビュー',()=>bundlePreview(i),parent);preview.disabled=Boolean(OFFLINE_DATA);const approve=button('選んだ内容をまとめて最終確認',()=>{const targets=selected(i);if(!targets.length)return note('確認する項目を選んでください。');ask({action:'approve_bundle',event_id:i.event.event_id,targets},'選んだ公開内容の最終確認',i.targets.filter(t=>selectedTargets.has(targetId(t))));},parent,'primary');approve.disabled=Boolean(OFFLINE_DATA);el('h3','現在、承認済みの公開内容',parent);const actual=state.approved_preview.filter(e=>e.event_id===i.event.event_id);if(!actual.length)el('p','現在は公開可能な出力がありません。',parent);for(const e of actual)reader(e,parent);if(lastResult?.results)detail('直前の項目別保存結果',lastResult,parent);}
function history(parent){el('h2','確認済み・履歴',parent);for(const t of state.work.completed){const a=el('article',undefined,parent);el('h3',t.article.title,a);el('p','確認記録済み・安全検証待ち。統合・進展・公開の確定ではありません。',a);el('p',jp(t.record.relation)+' ／ '+(t.record.progress?jp(t.record.progress):'進展は未確認'),a);el('p',jp(t.record.progress_assessment),a);el('small','確認日時：'+date(t.record.recorded_at)+'（日本時間）',a);detail('確認記録の詳細情報',t,a);const re=button('この判断を見直す',()=>{const reason=prompt('見直す理由を入力してください。');if(reason?.trim())post({action:'reopen_task',event_id:t.record.event_id,task_id:t.task_id,reason},{page:'list',category:'hold'});},a);re.disabled=Boolean(OFFLINE_DATA);}for(const h of state.history){const a=el('article',undefined,parent);el('p',jp(h.new_status)+' ／ '+date(h.at),a);el('p',h.reason,a);detail('操作の詳細情報',h,a);}detail('過去も含む確認記録の詳細情報',state.work.review_history,parent);detail('過去の運営者判断の原記録（未再検証）',state.legacy_operator_records,parent);button('確認記録をJSONで保存',exportRecords,parent);}
function exportRecords(){const value={scope:'isolated_review_only_not_authority',revision:state.revision,work:state.work,history:state.history};const u=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=u;a.download='news-now-local-review-records.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}
function render(){if(!state)return;$('content').replaceChildren();$('mode').textContent=OFFLINE_DATA?(state.data_scope==='synthetic_demo'?'閲覧専用・架空データ':'閲覧専用・未再検証'):(state.data_scope==='synthetic_demo'?'架空データ・操作練習':'隔離試作・本番反映なし');const p=$('content');let saved;try{saved=sessionStorage.getItem('news-now-work-pending');}catch{}if(saved&&!OFFLINE_DATA)button('未完了の操作を同じ番号で確認',async()=>{if(busy)return;busy=true;try{const data=await request('/api/operate',JSON.parse(saved));sessionStorage.removeItem('news-now-work-pending');state=data.state;note('保存状況を確認しました。');}catch(e){fail(e);}finally{busy=false;render();}},p);if(view.page==='home')dashboard(p);else if(view.page==='list')list(p);else if(view.page==='review')review(p);else if(view.page==='publication')publication(p);else history(p);}
$('home').onclick=()=>go({page:'home'});$('reload').onclick=refresh;$('history').onclick=()=>go({page:'history'});$('confirmNo').onclick=()=>{pending=null;$('confirmDialog').close();};$('confirmYes').onclick=()=>{if(!pending||busy)return;const reason=$('confirmReason').value.trim();if(!reason)return note('確認した理由を入力してください。');const command={...pending,confirmed:true,reason};pending=null;$('confirmDialog').close();post(command);};$('closePreview').onclick=()=>$('previewDialog').close();refresh();
</script></body></html>
