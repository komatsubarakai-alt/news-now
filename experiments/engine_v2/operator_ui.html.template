const REASON_OPTIONS={different_event:['発生場所が異なる','発生日時が異なる','関係人物が異なる','出来事が異なる','複数事件を扱う記事','その他'],hold:['本文未確認','引用根拠が不足','場所・時期が不明','情報に矛盾がある','追加調査が必要','その他'],none:['既報と同じ内容','新しい事実がない','解説・振り返り記事','既に記録済みの進展','その他'],new:['新しい事実を引用で確認','以前の記録との差を確認','重複か追加確認が必要','その他'],possible_correction:['以前の報道との食い違い','訂正・撤回を示す記述','対象の情報を追加確認','その他'],same_event:['事件を特定する記述を確認','追加調査が必要','その他']};
